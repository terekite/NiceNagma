# IDE
.idea/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
uv.lock

# Render artifacts / caches
*.wav
*.flac
*.mid
/tmp/nagma-cache/

# Large binary assets (decide per-file whether to commit; see assets/LICENSES.md)
assets/soundfonts/*.sf2
assets/soundfonts/*.sf3
assets/tanpura/*.wav
assets/tanpura/*.flac
# ...but DO commit the built multisample harmonium SF2 so render/CI/Docker are
# reproducible without a build step. License: CC0 (assets/LICENSES.md).
!assets/soundfonts/harmonium.sf2
# ...and the built plucked sitar SF2 (scripts/build_sitar.py). CC0 (LICENSES.md).
!assets/soundfonts/sitar.sf2
# Raw sample source (re-fetched/rebuilt by the build scripts) — don't commit.
assets/soundfonts/raw/

# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/ios/Pods/
app/ios/.symlinks/
app/**/GeneratedPluginRegistrant.*

# macOS
.DS_Store
